{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:gdd:manifest:prose-denylist",
  "title": "manifest/prose-denylist.json",
  "type": "object",
  "required": [
    "schema_version",
    "tells"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "tells": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "pattern",
          "kind"
        ],
        "properties": {
          "pattern": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "phrase",
              "token"
            ]
          }
        }
      }
    }
  }
}
