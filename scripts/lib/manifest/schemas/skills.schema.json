{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:gdd:manifest:skills",
  "title": "manifest/skills.json",
  "type": "object",
  "required": [
    "schema_version",
    "skills"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
